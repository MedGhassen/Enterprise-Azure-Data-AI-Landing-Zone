        <mxCell id="t1" value="CI/CD and Terraform state" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#201F1E;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry" /></mxCell>
        <mxCell id="t2" value="Public CI never touches Azure. Deployments use OIDC (no secrets), plan per environment, and apply exactly the reviewed plan, promoting dev → staging → prod." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#605E5C;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1400" height="20" as="geometry" /></mxCell>
        <mxCell id="i3" value="" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;fontSize=11;fontColor=#201F1E;labelBackgroundColor=none;image=img/lib/azure2/identity/Users.svg;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="t4" value="Contributor" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#201F1E;" vertex="1" parent="1"><mxGeometry x="14.0" y="160" width="100" height="44" as="geometry" /></mxCell>
        <mxCell id="p5" value="Pull request" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#605E5C;fontColor=#201F1E;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="150" y="112" width="120" height="44" as="geometry" /></mxCell>
        <mxCell id="b6" value=".github/workflows/ci.yml · runs on every PR (forks included), no credentials" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#EAF6EA;strokeColor=#107C10;fontColor=#201F1E;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=12;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="620" height="170" as="geometry" /></mxCell>
        <mxCell id="t7" value="• terraform fmt -check&lt;br&gt;• terraform validate (root + platform/)&lt;br&gt;• terraform test with mocked providers&lt;br&gt;• TFLint (terraform + azurerm rulesets)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#201F1E;" vertex="1" parent="b6"><mxGeometry x="20" y="40" width="290" height="110" as="geometry" /></mxCell>
        <mxCell id="t8" value="• Trivy IaC misconfiguration scan&lt;br&gt;• terraform-docs up to date&lt;br&gt;• shellcheck&lt;br&gt;• Dependabot: providers + actions weekly" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#201F1E;" vertex="1" parent="b6"><mxGeometry x="320" y="40" width="290" height="110" as="geometry" /></mxCell>
        <mxCell id="p9" value="merge to main" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#605E5C;fontColor=#201F1E;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="990" y="112" width="140" height="44" as="geometry" /></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=10;fontColor=#201F1E;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="i3" target="p5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
