        <mxCell id="t41" value="Storage account&lt;br&gt;sttfstate…" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#201F1E;" vertex="1" parent="b39"><mxGeometry x="-6.0" y="100" width="140" height="44" as="geometry" /></mxCell>
        <mxCell id="t42" value="• Entra ID auth only (&lt;i&gt;use_azuread_auth&lt;/i&gt;), shared keys disabled&lt;br&gt;• Blob versioning + 30-day soft delete for state recovery&lt;br&gt;• Storage Blob Data Contributor for each pipeline identity&lt;br&gt;• Backend values passed with -backend-config, never committed" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#201F1E;" vertex="1" parent="b39"><mxGeometry x="180" y="40" width="450" height="110" as="geometry" /></mxCell>
