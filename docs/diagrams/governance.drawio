        <mxCell id="b43" value="Deployments" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#8A8886;fontColor=#201F1E;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=12;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="1000" height="250" as="geometry" /></mxCell>
        <mxCell id="i44" value="" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;fontSize=11;fontColor=#201F1E;labelBackgroundColor=none;image=img/lib/azure2/general/Resource_Groups.svg;" vertex="1" parent="b43"><mxGeometry x="20" y="45" width="40" height="40" as="geometry" /></mxCell>
        <mxCell id="t45" value="&lt;b&gt;platform/&lt;/b&gt; (once per tenant): management groups, subscription placement, policy assignments, custom roles. Needs Management Group Contributor + Resource Policy Contributor + User Access Administrator at the parent management group." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#201F1E;" vertex="1" parent="b43"><mxGeometry x="75" y="40" width="900" height="50" as="geometry" /></mxCell>
        <mxCell id="i46" value="" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;fontSize=11;fontColor=#201F1E;labelBackgroundColor=none;image=img/lib/azure2/networking/Virtual_Networks.svg;" vertex="1" parent="b43"><mxGeometry x="20" y="115" width="40" height="40" as="geometry" /></mxCell>
        <mxCell id="t47" value="&lt;b&gt;Repository root&lt;/b&gt; (once per environment): the landing zone itself (hub/spoke, data, AI, serving) deployed into the matching &lt;i&gt;dataai_dev / dataai_staging / dataai_prod&lt;/i&gt; subscription, with its own state key &lt;i&gt;data-ai-landing-zone-&amp;lt;env&amp;gt;.tfstate&lt;/i&gt;." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#201F1E;" vertex="1" parent="b43"><mxGeometry x="75" y="110" width="900" height="50" as="geometry" /></mxCell>
        <mxCell id="i48" value="" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;fontSize=11;fontColor=#201F1E;labelBackgroundColor=none;image=img/lib/azure2/security/Azure_Defender.svg;" vertex="1" parent="b43"><mxGeometry x="20" y="185" width="40" height="40" as="geometry" /></mxCell>
        <mxCell id="t49" value="&lt;b&gt;Defender for Cloud&lt;/b&gt; plans are subscription-wide: enable them (enable_defender) in exactly one stack per subscription." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#201F1E;" vertex="1" parent="b43"><mxGeometry x="75" y="185" width="900" height="40" as="geometry" /></mxCell>
        <mxCell id="b50" value="Assigned at Landing Zones" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#EAF6EA;strokeColor=#107C10;fontColor=#201F1E;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=12;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1060" y="80" width="440" height="770" as="geometry" /></mxCell>
        <mxCell id="i51" value="" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;fontSize=11;fontColor=#201F1E;labelBackgroundColor=none;image=img/lib/azure2/management_governance/Policy.svg;" vertex="1" parent="b50"><mxGeometry x="20" y="45" width="40" height="40" as="geometry" /></mxCell>
        <mxCell id="t52" value="&lt;b&gt;Baseline policy&lt;/b&gt;&lt;br&gt;• Allowed locations (allowed_locations)&lt;br&gt;• Require tag on resource groups: environment, cost_center, owner (Deny)&lt;br&gt;• Inherit tag from resource group if missing (Modify, managed identity with Tag Contributor)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#201F1E;" vertex="1" parent="b50"><mxGeometry x="75" y="40" width="350" height="120" as="geometry" /></mxCell>
        <mxCell id="i53" value="" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;fontSize=11;fontColor=#201F1E;labelBackgroundColor=none;image=img/lib/azure2/general/Tags.svg;" vertex="1" parent="b50"><mxGeometry x="20" y="185" width="40" height="40" as="geometry" /></mxCell>
        <mxCell id="t54" value="&lt;b&gt;Regulatory compliance (optional, audit)&lt;/b&gt;&lt;br&gt;• ISO 27001:2013 (enable_iso27001)&lt;br&gt;• NIS2 (custom/partner initiative, enable_nis2)&lt;br&gt;• Additional initiatives (compliance_policy_assignments)&lt;br&gt;Scope selectable with compliance_policy_scope." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#201F1E;" vertex="1" parent="b50"><mxGeometry x="75" y="180" width="350" height="120" as="geometry" /></mxCell>
        <mxCell id="i55" value="" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;fontSize=11;fontColor=#201F1E;labelBackgroundColor=none;image=img/lib/azure2/identity/Entra_Privileged_Identity_Management.svg;" vertex="1" parent="b50"><mxGeometry x="20" y="335" width="40" height="40" as="geometry" /></mxCell>
        <mxCell id="t56" value="&lt;b&gt;Custom roles&lt;/b&gt; (assignable at Landing Zones)&lt;br&gt;• Data &amp;amp; AI Data Engineer: ADF, Synapse/Databricks read, Event Hubs, Stream Analytics, lake read/write&lt;br&gt;• Data &amp;amp; AI Data Scientist: Azure ML jobs/notebooks, Foundry projects, read curated data, query AI Search&lt;br&gt;• Data &amp;amp; AI ML Engineer: ML workspaces, Foundry deployments/projects, AKS user credentials, ACR" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#201F1E;" vertex="1" parent="b50"><mxGeometry x="75" y="330" width="350" height="190" as="geometry" /></mxCell>
        <mxCell id="i57" value="" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;fontSize=11;fontColor=#201F1E;labelBackgroundColor=none;image=img/lib/azure2/identity/Users.svg;" vertex="1" parent="b50"><mxGeometry x="20" y="545" width="40" height="40" as="geometry" /></mxCell>
        <mxCell id="t58" value="&lt;b&gt;Role assignments&lt;/b&gt;&lt;br&gt;role_assignments = [{ principal_id, role, scope }]&lt;br&gt;role: built-in or custom role name&lt;br&gt;scope: management group key (e.g. dataai_prod) or resource ID" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#201F1E;" vertex="1" parent="b50"><mxGeometry x="75" y="540" width="350" height="100" as="geometry" /></mxCell>
        <mxCell id="e59" value="policy + RBAC scope" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#107C10;strokeWidth=1.5;fontSize=10;fontColor=#201F1E;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=0;exitX=0;exitY=0.286;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b50" target="p5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="300" /><mxPoint x="760" y="228" /></Array></mxGeometry></mxCell>
      </root>
